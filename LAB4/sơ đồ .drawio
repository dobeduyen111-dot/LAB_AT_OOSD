        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nclass Customer {\n  +CustomerId\n  +FullName\n  +DateOfBirth\n  +IdPassport\n  +Address\n  +Phone\n  +Username\n  +Password\n  +Email\n}\nclass ProductCategory {\n  +CategoryId\n  +CategoryName\n}\nclass Product {\n  +ProductId\n  +ProductCode\n  +Name\n  +Manufacturer\n  +Description\n  +TechnicalSpecification\n  +CurrentPrice\n  +StockStatus\n}\nclass ShoppingCart {\n  +CartId\n  +CreatedDate\n}\nclass CartItem {\n  +Quantity\n  +UnitPrice\n}\nclass Order {\n  +OrderId\n  +OrderDate\n  +Subtotal\n  +ShippingFee\n  +TotalAmount\n  +Status\n}\nclass OrderDetail {\n  +Quantity\n  +UnitPrice\n  +Amount\n}\nclass Recipient {\n  +RecipientId\n  +FullName\n  +Address\n  +Phone\n}\nclass Shipping {\n  +ShippingId\n  +ShippingType\n  +Fee\n  +ProcessingTime\n}\nclass Payment {\n  +PaymentId\n  +CardType\n  +CardNumber\n  +ExpiryDate\n  +CardHolderName\n  +CSV\n  +Status\n}\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; ShoppingCart\nShoppingCart \&quot;1\&quot; -- \&quot;1..*\&quot; CartItem\nCartItem \&quot;*\&quot; --&gt; \&quot;1\&quot; Product\nProductCategory \&quot;1\&quot; -- \&quot;0..*\&quot; Product\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; Order\nOrder \&quot;1\&quot; -- \&quot;1..*\&quot; OrderDetail\nOrderDetail \&quot;*\&quot; --&gt; \&quot;1\&quot; Product\nOrder \&quot;1\&quot; -- \&quot;1\&quot; Recipient\nOrder \&quot;1\&quot; -- \&quot;1\&quot; Shipping\nOrder \&quot;1\&quot; -- \&quot;1\&quot; Payment\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NB2S4UBX6R0-J-iDRK6J-1">
