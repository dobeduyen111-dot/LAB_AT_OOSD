        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ERD - HỆ THỐNG e-SHOPPING\n\nhide methods\nhide stereotypes\n\nentity Customer {\n    * CustomerId : INT &lt;&lt;PK&gt;&gt;\n    --\n    FullName : NVARCHAR(100)\n    DateOfBirth : DATE\n    IdPassport : NVARCHAR(30)\n    Address : NVARCHAR(255)\n    Phone : VARCHAR(15)\n    Username : VARCHAR(50)\n    Password : VARCHAR(255)\n    Email : VARCHAR(100)\n}\n\nentity ProductCategory {\n    * CategoryId : INT &lt;&lt;PK&gt;&gt;\n    --\n    CategoryName : NVARCHAR(100)\n}\n\nentity Product {\n    * ProductId : INT &lt;&lt;PK&gt;&gt;\n    --\n    ProductCode : VARCHAR(50)\n    Name : NVARCHAR(200)\n    Manufacturer : NVARCHAR(100)\n    Description : NVARCHAR(MAX)\n    TechnicalSpecification : NVARCHAR(MAX)\n    CurrentPrice : DECIMAL(18,2)\n    StockStatus : NVARCHAR(50)\n    CategoryId : INT &lt;&lt;FK&gt;&gt;\n}\n\nentity ShoppingCart {\n    * CartId : INT &lt;&lt;PK&gt;&gt;\n    --\n    CreatedDate : DATETIME\n    CustomerId : INT &lt;&lt;FK&gt;&gt;\n}\n\nentity CartItem {\n    * CartItemId : INT &lt;&lt;PK&gt;&gt;\n    --\n    CartId : INT &lt;&lt;FK&gt;&gt;\n    ProductId : INT &lt;&lt;FK&gt;&gt;\n    Quantity : INT\n    UnitPrice : DECIMAL(18,2)\n}\n\nentity Order {\n    * OrderId : INT &lt;&lt;PK&gt;&gt;\n    --\n    CustomerId : INT &lt;&lt;FK&gt;&gt;\n    RecipientId : INT &lt;&lt;FK&gt;&gt;\n    ShippingId : INT &lt;&lt;FK&gt;&gt;\n    PaymentId : INT &lt;&lt;FK&gt;&gt;\n    OrderDate : DATETIME\n    Subtotal : DECIMAL(18,2)\n    ShippingFee : DECIMAL(18,2)\n    TotalAmount : DECIMAL(18,2)\n    Status : VARCHAR(30)\n}\n\nentity OrderDetail {\n    * OrderDetailId : INT &lt;&lt;PK&gt;&gt;\n    --\n    OrderId : INT &lt;&lt;FK&gt;&gt;\n    ProductId : INT &lt;&lt;FK&gt;&gt;\n    Quantity : INT\n    UnitPrice : DECIMAL(18,2)\n    Amount : DECIMAL(18,2)\n}\n\nentity Recipient {\n    * RecipientId : INT &lt;&lt;PK&gt;&gt;\n    --\n    FullName : NVARCHAR(100)\n    Address : NVARCHAR(255)\n    Phone : VARCHAR(15)\n}\n\nentity Shipping {\n    * ShippingId : INT &lt;&lt;PK&gt;&gt;\n    --\n    ShippingType : NVARCHAR(50)\n    Fee : DECIMAL(18,2)\n    ProcessingTime : NVARCHAR(100)\n}\n\nentity Payment {\n    * PaymentId : INT &lt;&lt;PK&gt;&gt;\n    --\n    CardType : VARCHAR(30)\n    CardNumber : VARCHAR(20)\n    ExpiryDate : DATE\n    CardHolderName : NVARCHAR(100)\n    CSV : VARCHAR(4)\n    Status : VARCHAR(30)\n}\n\n\n&#39; =========================\n&#39; CÁC QUAN HỆ\n&#39; =========================\n\nCustomer ||--o{ ShoppingCart : \&quot;có\&quot;\n\nShoppingCart ||--|{ CartItem : \&quot;chứa\&quot;\n\nProduct ||--o{ CartItem : \&quot;được thêm vào\&quot;\n\nProductCategory ||--o{ Product : \&quot;chứa\&quot;\n\nCustomer ||--o{ Order : \&quot;đặt\&quot;\n\nOrder ||--|{ OrderDetail : \&quot;gồm\&quot;\n\nProduct ||--o{ OrderDetail : \&quot;được đặt\&quot;\n\nOrder ||--|| Recipient : \&quot;có người nhận\&quot;\n\nOrder ||--|| Shipping : \&quot;sử dụng\&quot;\n\nOrder ||--|| Payment : \&quot;thanh toán\&quot;\n\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="s-odFKHMM8MwTA3EnId--1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
