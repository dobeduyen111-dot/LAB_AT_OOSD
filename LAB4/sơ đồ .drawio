        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CLASS DIAGRAM - UC04 XEM DANH SÁCH SẢN PHẨM\n\nskinparam classAttributeIconSize 0\n\nclass FrmProducts {\n    +ShowCategories()\n    +SelectCategory(categoryId : string)\n    +DisplayProducts(products : List&lt;Product&gt;)\n    +DisplayEmptyMessage()\n    +DisplayConnectionError()\n}\n\nclass ProductService {\n    +GetCategories() : List&lt;Category&gt;\n    +GetProductsByCategory(categoryId : string) : List&lt;Product&gt;\n    +ValidateCategory(categoryId : string) : bool\n}\n\nclass ProductApiAdapter {\n    +GetCategories() : List&lt;Category&gt;\n    +GetProductsByCategory(categoryId : string) : List&lt;Product&gt;\n    +Connect() : bool\n}\n\nclass Category {\n    -CategoryId : string\n    -CategoryName : string\n    -Description : string\n\n    +GetProducts() : List&lt;Product&gt;\n}\n\nclass Product {\n    -ProductCode : string\n    -ProductName : string\n    -Manufacturer : string\n    -Images : string\n    -Description : string\n    -TechnicalSpecifications : string\n    -CurrentPrice : decimal\n    -StockStatus : string\n    -CategoryId : string\n\n    +GetPrice() : decimal\n    +IsAvailable() : bool\n}\n\nclass \&quot;Product Management System\&quot; as PMS &lt;&lt;external system&gt;&gt;\n\nFrmProducts --&gt; ProductService : GetProductsByCategory()\nProductService --&gt; ProductApiAdapter : Request products\nProductApiAdapter --&gt; PMS : Get product list\n\nPMS --&gt; ProductApiAdapter : Product data\n\nProductApiAdapter --&gt; ProductService : List&lt;Product&gt;\nProductService --&gt; FrmProducts : List&lt;Product&gt;\n\nCategory \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Product : contains\n\nProductService ..&gt; Category : sử dụng\nProductService ..&gt; Product : trả về\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5zzQm81S4quUmBoh2k_c-68">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
