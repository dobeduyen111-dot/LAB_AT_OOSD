        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CLASS DIAGRAM - UC01 ĐĂNG KÝ TÀI KHOẢN\n\nskinparam classAttributeIconSize 0\n\nclass FrmRegister {\n    +ShowRegisterForm()\n    +GetCustomerInput()\n    +DisplaySuccess()\n    +DisplayError()\n}\n\nclass CustomerService {\n    +Register(customer : Customer) : bool\n    +ValidateCustomer(customer : Customer) : bool\n    +CheckUsername(username : string) : bool\n    +CreateAccount(customer : Customer) : bool\n}\n\nclass CustomerRepository {\n    +CheckUsername(username : string) : bool\n    +Create(customer : Customer) : bool\n    +GetByUsername(username : string) : Customer\n}\n\nclass Customer {\n    -CustomerId : int\n    -FullName : string\n    -DateOfBirth : Date\n    -IdPassport : string\n    -Address : string\n    -Phone : string\n    -Username : string\n    -PasswordHash : string\n    -Email : string\n\n    +Validate() : bool\n    +SetPassword(password : string)\n}\n\ndatabase \&quot;SQL Server\&quot; as DB\n\nFrmRegister --&gt; CustomerService : Register()\nCustomerService --&gt; Customer : Validate()\nCustomerService --&gt; CustomerRepository : CheckUsername()\nCustomerService --&gt; CustomerRepository : CreateAccount()\nCustomerRepository --&gt; DB : INSERT Customer\n\nCustomerService ..&gt; Customer : sử dụng\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5zzQm81S4quUmBoh2k_c-1">
