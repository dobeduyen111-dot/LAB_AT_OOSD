  <diagram id="LbASG99zH9yPklS_q9_6" name="Trang-3">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CLASS DIAGRAM - HỆ THỐNG QUẢN LÝ TOUR\n\ntop to bottom direction\nskinparam backgroundColor white\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam linetype ortho\n\nskinparam class {\n    BackgroundColor #FFF7CC\n    BorderColor #C2185B\n    ArrowColor #C2185B\n    FontColor black\n}\n\nskinparam ArrowColor #C2185B\nskinparam packageBorderColor #C2185B\n\nhide empty methods\n\nclass DiemThamQuan {\n  MaDiemTQ : String\n  TenDiemTQ : String\n  DiaDiem : String\n  NoiDung : String\n  YNghia : String\n}\n\nclass TourDiemThamQuan {\n  ThuTu : Integer\n}\n\nclass DiemDung {\n  ThuTu : Integer\n  TenDiemDung : String\n  DoiPhuongTien : Boolean\n  CoNoiAn : Boolean\n  CoKhachSan : Boolean\n  HangSaoKhachSan : Integer\n}\n\nclass Tour {\n  MaTour : String\n  TenTour : String\n  SoNgay : Integer\n  SoDem : Integer\n  DonGiaKhach : Decimal\n  MoTa : String\n  DangMoBan : Boolean\n}\n\nclass ChangPhuongTien {\n  ThuTuChang : Integer\n  GhiChu : String\n}\n\nclass PhuongTien {\n  MaPT : String\n  TenPT : String\n}\n\nclass ChuyenLe {\n  MaChuyen : String\n  NgayDi : Date\n  NgayVe : Date\n  DiaDiemDon : String\n  TrangThai : String\n}\n\nclass DiemBanVe {\n  MaDiemBan : String\n  TenDiemBan : String\n  DiaChi : String\n  DienThoai : String\n}\n\nabstract class PhieuDangKy {\n  SoPhieu : String\n  NgayDangKy : DateTime\n  SoNguoi : Integer\n  TrangThai : String\n}\n\nclass PhieuDangKyLe {\n  TenNguoiDangKy : String\n  DienThoai : String\n  ThanhTien : Decimal\n}\n\nclass PhieuDangKyDoan {\n  NgayDi : Date\n  NgayKetThucDuKien : Date\n  DiaDiemDon : String\n  MuaBaoHiem : Boolean\n  TienCoc : Decimal\n  TongTienDuKien : Decimal\n}\n\nclass DoanKhach {\n  MaDoan : String\n  TenCoQuanDaiDien : String\n  DiaChi : String\n  DienThoai : String\n  NguoiDaiDien : String\n}\n\nclass ThanhVienDoan {\n  STT : Integer\n  HoTen : String\n  NgaySinh : Date\n  SoGiayTo : String\n}\n\nclass ThanhToanDoan {\n  SoTT : String\n  NgayThanhToan : DateTime\n  SoTien : Decimal\n}\n\nclass HuongDanVien {\n  MaHDV : String\n  HoTen : String\n  DienThoai : String\n  LuongCoBan : Decimal\n}\n\nclass PhanCong {\n  MaPC : String\n  NgayBatDau : Date\n  NgayKetThuc : Date\n  ThuLaoTour : Decimal\n}\n\nclass PhieuKhaoSat {\n  MaKhaoSat : String\n  NgayGui : Date\n  NgayPhanHoi : Date\n  DiemDanhGia : Integer\n  GopY : String\n}\n\n&#39;=============================\n&#39; QUAN HỆ\n&#39;=============================\n\nDiemThamQuan \&quot;1\&quot; -- \&quot;0..*\&quot; TourDiemThamQuan\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; TourDiemThamQuan\n\nTour \&quot;1\&quot; *-- \&quot;1..*\&quot; DiemDung\nTour \&quot;1\&quot; *-- \&quot;1..*\&quot; ChangPhuongTien\nChangPhuongTien \&quot;0..*\&quot; -- \&quot;1\&quot; PhuongTien\n\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; ChuyenLe\n\nDiemBanVe \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDangKyLe\nChuyenLe \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDangKyLe\nPhieuDangKyLe --|&gt; PhieuDangKy\n\nPhieuDangKyDoan --|&gt; PhieuDangKy\nDoanKhach \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDangKyDoan\nPhieuDangKyDoan \&quot;1\&quot; *-- \&quot;0..*\&quot; ThanhVienDoan\nPhieuDangKyDoan \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanDoan\n\nHuongDanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCong\nPhieuDangKyDoan \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCong\nChuyenLe \&quot;1\&quot; -- \&quot;0..1\&quot; PhanCong\n\nPhieuDangKy \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuKhaoSat\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7kWkhmi834bLFh5GuUIy-623">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
