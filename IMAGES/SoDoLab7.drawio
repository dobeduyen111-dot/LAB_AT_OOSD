        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle PHÂN RÃ USE CASE - THỬ VIỆC ĐẾN KÝ HỢP ĐỒNG\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\n\nactor \&quot;Nhân viên nhân sự\&quot; as HR\n\nrectangle \&quot;QUY TRÌNH TUYỂN DỤNG VÀ KÝ HỢP ĐỒNG\&quot; {\n\n  usecase \&quot;Tiếp nhận thông tin\\nnhân viên\&quot; as NV\n\n  usecase \&quot;UC02\\nLập quyết định\\ntuyển dụng thử việc\&quot; as TV\n  usecase \&quot;Chọn phòng ban\\nthử việc\&quot; as PB\n  usecase \&quot;Ghi thời gian\\nthử việc\&quot; as TG\n  usecase \&quot;Ghi mức lương\\nthử việc\&quot; as LT\n  usecase \&quot;Ghi điều khoản\\nhai bên\&quot; as DK\n  usecase \&quot;Kiểm tra quyết định\&quot; as KT\n\n  usecase \&quot;UC03\\nKý hợp đồng\\nlao động\&quot; as HD\n  usecase \&quot;Tra cứu quyết định\\ntuyển dụng\&quot; as TC\n  usecase \&quot;Chọn loại hợp đồng\&quot; as LH\n  usecase \&quot;Ghi thông tin\\nhợp đồng\&quot; as NH\n  usecase \&quot;Lưu hợp đồng\&quot; as LHĐ\n\n  usecase \&quot;UC06\\nLập hồ sơ\\nBHYT và BHXH\&quot; as BH\n}\n\nHR -- NV\nHR -- TV\nHR -- HD\n\nTV ..&gt; NV : &lt;&lt;include&gt;&gt;\nTV ..&gt; PB : &lt;&lt;include&gt;&gt;\nTV ..&gt; TG : &lt;&lt;include&gt;&gt;\nTV ..&gt; LT : &lt;&lt;include&gt;&gt;\nTV ..&gt; DK : &lt;&lt;include&gt;&gt;\nTV ..&gt; KT : &lt;&lt;include&gt;&gt;\n\nHD ..&gt; TC : &lt;&lt;include&gt;&gt;\nHD ..&gt; LH : &lt;&lt;include&gt;&gt;\nHD ..&gt; NH : &lt;&lt;include&gt;&gt;\nHD ..&gt; LHĐ : &lt;&lt;include&gt;&gt;\n\nBH ..&gt; HD : &lt;&lt;extend&gt;&gt;\n\nnote right of BH\nĐiều kiện mở rộng:\nHợp đồng dài hạn.\nend note\n\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0wyAULjkfS5YbuaxOHUz-1">
