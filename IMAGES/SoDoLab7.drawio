        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ACTIVITY DIAGRAM - THU VIEC DEN KY HOP DONG\n\nskinparam shadowing false\nskinparam ArrowColor #B32050\n\nskinparam activity {\n  BackgroundColor #FFF7CC\n  BorderColor #B32050\n  DiamondBackgroundColor #FFF7CC\n  DiamondBorderColor #B32050\n}\n\nstart\n\n|Nhân viên nhân sự|\n:Tiếp nhận thông tin nhân viên;\n:Lập quyết định tuyển dụng;\n:Ghi phòng ban, thời gian,\\nlương thử việc và điều khoản;\n\n|Hệ thống|\n:Kiểm tra thông tin;\n\nif (Hợp lệ?) then (Có)\n  :Lưu quyết định tuyển dụng;\nelse (Không)\n  :Thông báo cần bổ sung;\n  stop\nendif\n\n|Phòng ban|\n:Tiếp nhận và thực hiện thử việc;\n:Kết thúc thời gian thử việc;\n\n|Nhân viên nhân sự|\n:Lập hợp đồng lao động;\n:Chọn loại hợp đồng;\n\n|Hệ thống|\n:Kiểm tra và lưu hợp đồng;\n\nif (Hợp đồng dài hạn?) then (Có)\n  |Nhân viên nhân sự|\n  :Lập hồ sơ BHYT và BHXH;\n  |Hệ thống|\n  :Lưu hồ sơ bảo hiểm;\nelse (Không)\n  :Ghi nhận hợp đồng ngắn hạn;\nendif\n\n:Hoàn tất quy trình;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="b_Lg4aKYBB7ETSbJqCRy-87">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
