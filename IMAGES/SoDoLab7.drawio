        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Hình P.7 - KIẾN TRÚC HỆ THỐNG QUẢN LÝ NHÂN SỰ\n\nleft to right direction\nskinparam shadowing false\nskinparam component {\n  BackgroundColor #FFF7CF\n  BorderColor #C21D50\n}\n\npackage \&quot;GIAO DIỆN - WINFORMS\&quot; {\n  [FrmNhanVien] as F1\n  [FrmTuyenDung] as F2\n  [FrmHopDong] as F3\n  [FrmChamCong] as F4\n  [FrmLuong] as F5\n  [FrmKhenThuong] as F6\n}\n\npackage \&quot;XỬ LÝ NGHIỆP VỤ - SERVICE\&quot; {\n  [NhanSuService] as S1\n  [TuyenDungService] as S2\n  [HopDongService] as S3\n  [ChamCongService] as S4\n  [LuongService] as S5\n  [KhenThuongService] as S6\n}\n\npackage \&quot;TRUY CẬP DỮ LIỆU\&quot; {\n  [Db.cs] as DB\n}\n\ndatabase \&quot;SQL Server\\nQuanLyNhanSu\&quot; as SQL\n\nF1 --&gt; S1\nF2 --&gt; S2\nF3 --&gt; S3\nF4 --&gt; S4\nF5 --&gt; S5\nF6 --&gt; S6\n\nS1 --&gt; DB\nS2 --&gt; DB\nS3 --&gt; DB\nS4 --&gt; DB\nS5 --&gt; DB\nS6 --&gt; DB\n\nDB --&gt; SQL\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FxVqDYFeXFC9kIeKpR0m-1">
