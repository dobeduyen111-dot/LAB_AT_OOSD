        <UserObject label="Hình P.4 - TRẠNG THÁI THỬ VIỆC VÀ HỢP ĐỒNG" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Hình P.4 - TRẠNG THÁI THỬ VIỆC VÀ HỢP ĐỒNG" id="tfMO7rYtOX0GWMsWT7yW-21">
          <mxCell parent="tfMO7rYtOX0GWMsWT7yW-1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="24" width="348" x="87.245" y="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Hình P.5 - LẬP QUYẾT ĐỊNH KHEN THƯỞNG\n\nskinparam shadowing false\n\nactor \&quot;Nhân viên nhân sự\&quot; as HR\nactor \&quot;Giám đốc\&quot; as GD\n\nboundary \&quot;FrmKhenThuong\&quot; as UI\ncontrol \&quot;KhenThuongService\&quot; as SV\nentity \&quot;NhanVien / PhongBan\&quot; as DT\ndatabase \&quot;SQL Server\&quot; as DB\n\nHR -&gt; UI : Mở chức năng khen thưởng\nUI -&gt; SV : LayDanhSachDoiTuong()\nSV -&gt; DT : TraCuuNhanVienPhongBan()\nDT --&gt; SV : Danh sách đối tượng\nSV --&gt; UI : Hiển thị danh sách\n\nHR -&gt; UI : Chọn nhân viên hoặc phòng ban\nHR -&gt; UI : Nhập nội dung, ngày, số tiền\n\nHR -&gt; UI : Nhấn \&quot;Lập quyết định\&quot;\nUI -&gt; SV : LapQuyetDinh(thongTin)\n\nSV -&gt; SV : KiemTraDuLieu()\n\nalt Thông tin không hợp lệ\n  SV --&gt; UI : Thông báo lỗi\n  UI --&gt; HR : Yêu cầu nhập lại\nelse Thông tin hợp lệ\n\n  alt Khen thưởng cá nhân\n    SV -&gt; DT : KiemTraNhanVien(maNV)\n    DT --&gt; SV : Kết quả\n  else Khen thưởng tập thể\n    SV -&gt; DT : KiemTraPhongBan(maPhongBan)\n    DT --&gt; SV : Kết quả\n  end\n\n  SV -&gt; DB : INSERT QuyetDinhKhenThuong\n  note right of DB\n    Trạng thái = Chờ ký\n  end note\n\n  DB --&gt; SV : Mã quyết định\n  SV --&gt; UI : Lập quyết định thành công\n  UI --&gt; HR : Hiển thị quyết định\n\n  GD -&gt; UI : Xem xét và ký\n  UI -&gt; SV : GhiNhanKy(soQDKT)\n  SV -&gt; DB : UPDATE TrangThaiKy\n  DB --&gt; SV : Xác nhận cập nhật\n  SV --&gt; UI : Quyết định đã ký\nend\n\nnote over UI,SV\n  Lập phiếu chi khen thưởng\n  là nghiệp vụ UC13 riêng.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tfMO7rYtOX0GWMsWT7yW-22">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
