  <diagram id="KM8jufzhFUdjRIdGCQod" name="SD">
    <mxGraphModel dx="1456" dy="1459" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence 1 - Lap lich chuyen khach le\n\nautonumber\nactor \&quot;NV điều hành\&quot; as NV\nboundary \&quot;FrmChuyenLe\&quot; as Form\ncontrol \&quot;ChuyenLeService\&quot; as Service\ndatabase \&quot;SQL Server\&quot; as DB\n\nNV -&gt; Form : Mở form lập lịch chuyến\nactivate Form\n\nForm -&gt; Service : LayChuyen()\nactivate Service\nService -&gt; DB : SELECT danh sách ChuyenLe\nDB --&gt; Service : Danh sách chuyến\nService --&gt; Form : DataTable\ndeactivate Service\n\nNV -&gt; Form : Nhập mã chuyến, tour,\\nngày đi, địa điểm đón\nNV -&gt; Form : Nhấn Thêm chuyến\n\nForm -&gt; Service : ThemChuyen(ma, maTour,\\nngayDi, diaDiemDon)\nactivate Service\n\nalt Thiếu thông tin bắt buộc\n  Service --&gt; Form : Fail(\&quot;Thông tin chuyến chưa đầy đủ\&quot;)\nelse Thông tin đã nhập đầy đủ\n  Service -&gt; DB : SELECT SoNgay FROM Tour\\nWHERE MaTour = maTour\\nAND DangMoBan = 1\n  DB --&gt; Service : SoNgay hoặc null\n\n  alt Tour không tồn tại hoặc chưa mở bán\n    Service --&gt; Form : Fail(\&quot;Tour không tồn tại\\nhoặc chưa mở bán\&quot;)\n  else Tour hợp lệ\n    Service -&gt; Service : ngayVe = ngayDi.Date\\n.AddDays(SoNgay - 1)\n    Service -&gt; DB : INSERT ChuyenLe\\n(MaChuyen, MaTour, NgayDi,\\nNgayVe, DiaDiemDon, TrangThai)\n    alt Lưu thành công\n      DB --&gt; Service : Thành công\n      Service --&gt; Form : Ok(\&quot;Đã tạo chuyến\&quot;, ngayVe)\n      Form --&gt; NV : Hiển thị ngày về và thông báo\n    else Lỗi SQL\n      DB --&gt; Service : Exception\n      Service --&gt; Form : Fail(thông báo lỗi)\n    end\n  end\nend\n\ndeactivate Service\ndeactivate Form\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FtKTgAEpW-IWHohnNDkY-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=14;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
