        <UserObject label="Sequence 1 - Lap lich chuyen khach le" plantUmlId="title_50" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence 1 - Lap lich chuyen khach le" id="FtKTgAEpW-IWHohnNDkY-52">
          <mxCell parent="FtKTgAEpW-IWHohnNDkY-1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="286.6847" x="310.7755821428572" y="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence 2 - Huy dang ky doan va mat coc\n\nautonumber\nactor \&quot;NV kinh doanh\&quot; as NV\nboundary \&quot;FrmDangKyDoan\&quot; as Form\ncontrol \&quot;DangKyDoanService\&quot; as Service\ndatabase \&quot;SQL Server\&quot; as DB\n\nNV -&gt; Form : Chọn phiếu đoàn cần hủy\nNV -&gt; Form : Nhấn Hủy đăng ký\nactivate Form\n\nForm -&gt; Service : HuyDangKy(soDK)\nactivate Service\n\nalt Chưa chọn số đăng ký\n  Service --&gt; Form : Fail(\&quot;Chưa chọn phiếu\&quot;)\nelse Đã chọn số đăng ký\n  Service -&gt; DB : SELECT NgayDi, TrangThai\\nFROM DangKyDoan\n  DB --&gt; Service : Kết quả tìm kiếm\n\n  alt Không tìm thấy phiếu\n    Service --&gt; Form : Fail(\&quot;Không tìm thấy phiếu\&quot;)\n  else Trạng thái không phải Đã đăng ký\n    Service --&gt; Form : Fail(\&quot;Không thể hủy phiếu\&quot;)\n  else Ngày đi &lt;= ngày hiện tại\n    Service --&gt; Form : Fail(\&quot;Đoàn đã khởi hành\&quot;)\n  else Phiếu hợp lệ để hủy\n    Service -&gt; DB : BEGIN TRANSACTION\n\n    group Hủy phiếu và gỡ phân công\n      Service -&gt; DB : DELETE FROM PhanCongHDV\\nWHERE SoDKDoan = soDK\n      Service -&gt; DB : UPDATE DangKyDoan\\nSET TrangThai = &#39;Hủy - mất cọc&#39;\n    end\n\n    alt Hai thao tác thành công\n      Service -&gt; DB : COMMIT\n      DB --&gt; Service : Thành công\n      Service --&gt; Form : Ok(\&quot;Đã hủy phiếu, mất cọc\&quot;)\n      Form --&gt; NV : Thông báo hủy thành công\n    else Có lỗi xử lý\n      DB --&gt; Service : Exception\n      Service -&gt; DB : ROLLBACK\n      Service --&gt; Form : Fail(thông báo lỗi)\n    end\n  end\nend\n\ndeactivate Service\ndeactivate Form\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FtKTgAEpW-IWHohnNDkY-53">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=14;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
