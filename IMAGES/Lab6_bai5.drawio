        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\nleft to right direction\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;NV tiếp nhận\&quot; as TN\nactor \&quot;NV thu phí\&quot; as TP\nactor \&quot;Bác sĩ\&quot; as BS\nactor \&quot;NV xét nghiệm\&quot; as XN\n\nrectangle \&quot;QUY TRÌNH KHÁM BỆNH\&quot; {\n  usecase \&quot;Đăng ký khám bệnh\&quot; as DK\n  usecase \&quot;Tra cứu hồ sơ\&quot; as TRA\n  usecase \&quot;Đăng ký bệnh nhân mới\&quot; as MOI\n  usecase \&quot;Thu lệ phí năm đầu\&quot; as PHI\n  usecase \&quot;Cấp hồ sơ bệnh án\&quot; as CAP\n  usecase \&quot;Lập phiếu khám\&quot; as PK\n\n  usecase \&quot;Khám bệnh\&quot; as KHAM\n  usecase \&quot;Xem lịch sử bệnh án\&quot; as LS\n  usecase \&quot;Ghi nhận triệu chứng\&quot; as TC\n  usecase \&quot;Ghi nhận chẩn đoán\&quot; as CD\n\n  usecase \&quot;Chỉ định xét nghiệm\&quot; as CDXN\n  usecase \&quot;Ghi kết quả xét nghiệm\&quot; as KQXN\n  usecase \&quot;Xem kết quả xét nghiệm\&quot; as XEMKQ\n\n  usecase \&quot;Lập toa thuốc\&quot; as TOA\n  usecase \&quot;Chọn thuốc và liều dùng\&quot; as CHON\n  usecase \&quot;Lưu toa thuốc\&quot; as LUU\n  usecase \&quot;Cung cấp toa thuốc\&quot; as NHAN\n}\n\nBN -- DK\nBN -- NHAN\nTN -- DK\nTN -- MOI\nTN -- CAP\nTP -- PHI\nBS -- KHAM\nBS -- CDXN\nBS -- XEMKQ\nBS -- TOA\nXN -- KQXN\n\nDK ..&gt; TRA : &lt;&lt;include&gt;&gt;\nDK ..&gt; PK : &lt;&lt;include&gt;&gt;\n\nMOI ..&gt; DK : &lt;&lt;extend&gt;&gt;\nCAP ..&gt; MOI : &lt;&lt;extend&gt;&gt;\nCAP ..&gt; PHI : &lt;&lt;include&gt;&gt;\n\nKHAM ..&gt; LS : &lt;&lt;include&gt;&gt;\nKHAM ..&gt; TC : &lt;&lt;include&gt;&gt;\nKHAM ..&gt; CD : &lt;&lt;include&gt;&gt;\n\nCDXN ..&gt; KHAM : &lt;&lt;extend&gt;&gt;\nXEMKQ ..&gt; KHAM : &lt;&lt;extend&gt;&gt;\n\nTOA ..&gt; KHAM : &lt;&lt;extend&gt;&gt;\nTOA ..&gt; CHON : &lt;&lt;include&gt;&gt;\nTOA ..&gt; LUU : &lt;&lt;include&gt;&gt;\nTOA ..&gt; NHAN : &lt;&lt;include&gt;&gt;\n\nnote right of MOI\n  Khi bệnh nhân chưa có hồ sơ\nend note\n\nnote right of CDXN\n  Chỉ xét nghiệm khi cần thiết\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rLdN43u7DVGPPZgDCHqb-81">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
