        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor \&quot;NV chăm sóc KH\&quot; as NV\nboundary \&quot;FrmHoSoBenhAn\&quot; as F\ncontrol \&quot;HoSoBenhAnService\&quot; as S\ndatabase \&quot;SQL Server\&quot; as DB\n\nNV -&gt; F : Chọn phiếu khám đã điều trị\nF -&gt; S : TraCuuPhieuKham(maPhieuKham)\nactivate S\n\nS -&gt; DB : SELECT thông tin phiếu khám\nDB --&gt; S : Thông tin điều trị\nS --&gt; F : Hiển thị thông tin\ndeactivate S\n\nNV -&gt; F : Nhấn Cập nhật lịch sử\nF -&gt; S : CapNhatLichSu(maPhieuKham)\nactivate S\n\nS -&gt; DB : Kiểm tra thanh toán viện phí\nDB --&gt; S : Trạng thái thanh toán\n\nS -&gt; DB : Kiểm tra hoàn tất ra viện\nDB --&gt; S : Tình trạng ra viện\n\nalt Chưa đủ điều kiện\n  S --&gt; F : Từ chối cập nhật\n  F --&gt; NV : Thông báo chưa đủ điều kiện\nelse Đủ điều kiện\n  S -&gt; DB : BEGIN TRANSACTION\n\n  S -&gt; DB : INSERT LichSuCapNhat\n  S -&gt; DB : UPDATE PhieuKham\n\n  alt Thành công\n    S -&gt; DB : COMMIT\n    S --&gt; F : Cập nhật thành công\n    F --&gt; NV : Xác nhận hoàn tất\n  else Có lỗi\n    S -&gt; DB : ROLLBACK\n    S --&gt; F : Cập nhật thất bại\n  end\nend\n\ndeactivate S\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fgbHhp_kcXnjVIugLhCc-171">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
