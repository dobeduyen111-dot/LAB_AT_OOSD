        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\nleft to right direction\nskinparam classAttributeIconSize 0\n\nclass FrmLapToaThuoc &lt;&lt;boundary&gt;&gt; {\n  +ChonPhieuKham()\n  +ChonThuoc()\n  +NhapLieuDung()\n  +XuLyLuuToaThuoc()\n}\n\nclass ToaThuocService &lt;&lt;control&gt;&gt; {\n  +LayThongTinPhieuKham(maPhieu): object\n  +LapToaThuoc(thongTin, danhSachThuoc): bool\n  +KiemTraDuLieu(): bool\n  +LuuToaVaChiTiet(): bool\n}\n\nclass SqlServerDb &lt;&lt;database&gt;&gt; {\n  +ExecuteQuery()\n  +ExecuteNonQuery()\n  +BeginTransaction()\n  +Commit()\n  +Rollback()\n}\n\nclass PhieuKham &lt;&lt;entity&gt;&gt; {\n  +MaPhieuKham: string\n  +ChanDoan: string\n}\n\nclass ToaThuoc &lt;&lt;entity&gt;&gt; {\n  +MaToa: string\n  +NgayLap: Date\n  +LoiDan: string\n  +lapToa()\n  +luuToa()\n}\n\nclass ChiTietToaThuoc &lt;&lt;entity&gt;&gt; {\n  +MaToa: string\n  +MaThuoc: string\n  +SoLuong: int\n  +LieuDung: string\n  +CachDung: string\n  +themChiTiet()\n}\n\nclass Thuoc &lt;&lt;entity&gt;&gt; {\n  +MaThuoc: string\n  +TenThuoc: string\n  +DonViTinh: string\n  +traCuuThuoc()\n}\n\nFrmLapToaThuoc ..&gt; ToaThuocService\nToaThuocService ..&gt; SqlServerDb\n\nToaThuocService ..&gt; PhieuKham\nToaThuocService ..&gt; ToaThuoc\nToaThuocService ..&gt; ChiTietToaThuoc\nToaThuocService ..&gt; Thuoc\n\nPhieuKham \&quot;1\&quot; *-- \&quot;0..1\&quot; ToaThuoc\nToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc\nThuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietToaThuoc\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xWsuRyZZRA6u5QILNfdH-259">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
