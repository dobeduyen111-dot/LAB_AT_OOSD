        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor \&quot;Bác sĩ\&quot; as BS\nactor \&quot;NV xét nghiệm\&quot; as NV\n\nboundary \&quot;FrmKhamBenh\&quot; as FK\nboundary \&quot;FrmXetNghiem\&quot; as FX\ncontrol \&quot;XetNghiemService\&quot; as S\ndatabase \&quot;SQL Server\&quot; as DB\n\nBS -&gt; FK : Chọn phiếu khám và xét nghiệm\nFK -&gt; S : LapChiDinh(maPhieuKham, maLoaiXN)\nactivate S\n\nS -&gt; S : KiemTraChiDinh()\n\nalt Chỉ định không hợp lệ\n  S --&gt; FK : Thông báo lỗi\nelse Chỉ định hợp lệ\n  S -&gt; DB : INSERT ChiDinhXetNghiem\n  DB --&gt; S : MaChiDinh\n  S --&gt; FK : Lập chỉ định thành công\nend\ndeactivate S\n\nNV -&gt; FX : Mở danh sách xét nghiệm\nFX -&gt; S : LayChiDinhChoXuLy()\nactivate S\nS -&gt; DB : SELECT chỉ định chưa hoàn thành\nDB --&gt; S : Danh sách chỉ định\nS --&gt; FX : Hiển thị danh sách\ndeactivate S\n\nNV -&gt; FX : Nhập kết quả xét nghiệm\nFX -&gt; S : GhiKetQua(maChiDinh, ketQua)\nactivate S\nS -&gt; S : KiemTraKetQua()\n\nalt Kết quả không hợp lệ\n  S --&gt; FX : Thông báo lỗi\nelse Kết quả hợp lệ\n  S -&gt; DB : UPDATE ChiDinhXetNghiem\n  DB --&gt; S : Đã cập nhật\n  S --&gt; FX : Ghi kết quả thành công\nend\ndeactivate S\n\nBS -&gt; FK : Xem kết quả xét nghiệm\nFK -&gt; S : LayKetQua(maPhieuKham)\nactivate S\nS -&gt; DB : SELECT kết quả xét nghiệm\nDB --&gt; S : Dữ liệu kết quả\nS --&gt; FK : Thông tin kết quả\ndeactivate S\n\nFK --&gt; BS : Hiển thị kết quả\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fgbHhp_kcXnjVIugLhCc-111">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
