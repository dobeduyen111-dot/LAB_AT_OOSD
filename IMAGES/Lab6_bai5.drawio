        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nhide circle\n\nclass BenhNhan {\n  +MaBN: string\n  +HoTen: string\n  +DiaChi: string\n  +NgaySinh: Date\n  +DienThoai: string\n  +Anh3x4: string\n  --\n  +dangKy(): bool\n  +capNhat(): bool\n  +kiemTraThongTin(): bool\n}\n\nclass PhieuDangKy {\n  +MaPhieuDK: string\n  +MaBN: string\n  +NgayDangKy: Date\n  +TrangThai: string\n  --\n  +lapPhieu(): bool\n  +kiemTra(): bool\n  +xacNhanDangKy(): bool\n}\n\nclass PhiQuanLyNam {\n  +MaPhi: string\n  +MaBN: string\n  +Nam: int\n  +SoTien: decimal\n  +NgayDong: Date\n  +TrangThai: string\n  --\n  +ghiNhanPhi(): bool\n  +kiemTraHieuLuc(): bool\n}\n\nclass HoSoBenhAn {\n  +MaHoSo: string\n  +MaBN: string\n  +NgayCap: Date\n  +TrangThai: string\n  --\n  +capHoSo(): bool\n  +traCuuLichSu(): void\n  +kiemTraDieuKienCap(): bool\n}\n\nclass KhoaDieuTri {\n  +MaKhoa: string\n  +TenKhoa: string\n  +MoTa: string\n  --\n  +themKhoa(): bool\n  +capNhatKhoa(): bool\n}\n\nclass BacSi {\n  +MaBS: string\n  +MaKhoa: string\n  +HoTen: string\n  +ChuyenMon: string\n  +DienThoai: string\n  --\n  +traCuu(): void\n  +khamBenh(): bool\n  +chiDinhXetNghiem(): bool\n}\n\nclass PhieuKham {\n  +MaPhieuKham: string\n  +MaHoSo: string\n  +MaBS: string\n  +MaKhoa: string\n  +NgayGio: DateTime\n  +LoaiKham: string\n  +TrieuChung: string\n  +HuyetAp: string\n  +ThanNhiet: decimal\n  +ChanDoan: string\n  +TrangThai: string\n  --\n  +lapPhieuKham(): bool\n  +ghiChanDoan(): bool\n  +ghiNhanTrieuChung(): bool\n  +capNhatTrangThai(): bool\n}\n\nclass LoaiXetNghiem {\n  +MaLoaiXN: string\n  +TenXetNghiem: string\n  +MoTa: string\n  --\n  +themLoaiXN(): bool\n  +traCuuLoaiXN(): void\n}\n\nclass ChiDinhXetNghiem {\n  +MaChiDinh: string\n  +MaPhieuKham: string\n  +MaLoaiXN: string\n  +NgayChiDinh: DateTime\n  +KetQua: string\n  +TrangThai: string\n  --\n  +lapChiDinh(): bool\n  +ghiKetQua(): bool\n  +kiemTraChiDinh(): bool\n}\n\nclass Thuoc {\n  +MaThuoc: string\n  +TenThuoc: string\n  +DonViTinh: string\n  +GhiChu: string\n  --\n  +traCuuThuoc(): void\n  +themThuoc(): bool\n}\n\nclass ToaThuoc {\n  +MaToa: string\n  +MaPhieuKham: string\n  +NgayLap: Date\n  +LoiDan: string\n  --\n  +lapToa(): bool\n  +xemToa(): void\n  +kiemTraToa(): bool\n  +luuToa(): bool\n}\n\nclass ChiTietToaThuoc {\n  +MaToa: string\n  +MaThuoc: string\n  +SoLuong: int\n  +LieuDung: string\n  +CachDung: string\n  --\n  +themChiTiet(): bool\n  +capNhatChiTiet(): bool\n  +kiemTraSoLuong(): bool\n}\n\nclass LichHen {\n  +MaLichHen: string\n  +MaBN: string\n  +NgayGioHen: DateTime\n  +LoaiKham: string\n  +TrangThai: string\n  --\n  +datLich(): bool\n  +huyLich(): bool\n  +kiemTraQuyenLoi(): bool\n}\n\nclass ThanhToanVienPhi {\n  +MaThanhToan: string\n  +MaPhieuKham: string\n  +NgayThanhToan: DateTime\n  +SoTien: decimal\n  +TrangThai: string\n  --\n  +ghiThanhToan(): bool\n  +kiemTraThanhToan(): bool\n}\n\nclass LichSuCapNhat {\n  +MaNhatKy: string\n  +MaPhieuKham: string\n  +NgayCapNhat: DateTime\n  +NguoiCapNhat: string\n  +NoiDung: string\n  --\n  +ghiNhanSauXuatVien(): bool\n  +kiemTraDieuKienCapNhat(): bool\n}\n\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDangKy\nBenhNhan \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBenhAn\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; PhiQuanLyNam\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; LichHen\n\nHoSoBenhAn \&quot;1\&quot; *-- \&quot;0..*\&quot; PhieuKham\n\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; BacSi\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\n\nPhieuKham \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiDinhXetNghiem\nLoaiXetNghiem \&quot;1\&quot; -- \&quot;0..*\&quot; ChiDinhXetNghiem\n\nPhieuKham \&quot;1\&quot; *-- \&quot;0..1\&quot; ToaThuoc\nToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc\nThuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietToaThuoc\n\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanVienPhi\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuCapNhat\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mVzueAnOAxFrmCnsPhJ3-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
