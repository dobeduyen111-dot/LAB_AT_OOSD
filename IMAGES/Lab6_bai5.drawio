      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\n\nstart\n\n:Bệnh nhân yêu cầu đăng ký khám;\n\n:NV tiếp nhận tra cứu bệnh nhân;\n\nif (Đã có hồ sơ bệnh án?) then (Có)\n  :Lấy hồ sơ hiện có;\nelse (Không)\n  :Nhập thông tin bệnh nhân;\n  :Kiểm tra thông tin đăng ký;\n\n  while (Thông tin chưa hợp lệ?) is (Có)\n    :Yêu cầu chỉnh sửa;\n    :Nhập lại thông tin;\n    :Kiểm tra thông tin;\n  endwhile (Không)\n\n  :Thu lệ phí quản lý năm đầu;\n  :Cấp hồ sơ bệnh án;\nendif\n\n:Lập phiếu khám bệnh;\n\n:Bác sĩ xem lịch sử bệnh án;\n\n:Bác sĩ khám và ghi nhận triệu chứng;\n\nif (Cần xét nghiệm?) then (Có)\n  :Lập chỉ định xét nghiệm;\n  :Nhân viên xét nghiệm thực hiện;\n  :Ghi nhận kết quả xét nghiệm;\n  :Bác sĩ xem kết quả;\nelse (Không)\nendif\n\n:Bác sĩ ghi nhận chẩn đoán;\n\nif (Cần kê toa thuốc?) then (Có)\n  :Chọn thuốc điều trị;\n  :Nhập số lượng, liều và cách dùng;\n  :Kiểm tra toa thuốc;\n\n  while (Toa thuốc chưa hợp lệ?) is (Có)\n    :Điều chỉnh thông tin thuốc;\n    :Kiểm tra lại toa;\n  endwhile (Không)\n\n  :Lưu toa và chi tiết toa;\n  :Cung cấp toa thuốc cho bệnh nhân;\nelse (Không)\n  :Thông báo kết luận khám;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kBd3-MHLYvPVUXl_JiSD-1">
