        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide circle\nskinparam classAttributeIconSize 0\n\nentity BenhNhan {\n  *MaBN : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  HoTen : NVARCHAR(100)\n  DiaChi : NVARCHAR(255)\n  NgaySinh : DATE\n  DienThoai : VARCHAR(20)\n  Anh3x4 : NVARCHAR(255)\n}\n\nentity PhieuDangKy {\n  *MaPhieuDK : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaBN : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  NgayDangKy : DATE\n  TrangThai : NVARCHAR(30)\n}\n\nentity PhiQuanLyNam {\n  *MaPhi : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaBN : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  Nam : INT\n  SoTien : DECIMAL\n  NgayDong : DATE\n  TrangThai : NVARCHAR(30)\n}\n\nentity HoSoBenhAn {\n  *MaHoSo : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaBN : NVARCHAR(20) &lt;&lt;FK,UNIQUE&gt;&gt;\n  NgayCap : DATE\n  TrangThai : NVARCHAR(30)\n}\n\nentity KhoaDieuTri {\n  *MaKhoa : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenKhoa : NVARCHAR(100)\n  MoTa : NVARCHAR(255)\n}\n\nentity BacSi {\n  *MaBS : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaKhoa : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  HoTen : NVARCHAR(100)\n  ChuyenMon : NVARCHAR(100)\n  DienThoai : VARCHAR(20)\n}\n\nentity PhieuKham {\n  *MaPhieuKham : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaHoSo : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  MaBS : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  MaKhoa : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  NgayGio : DATETIME2\n  LoaiKham : NVARCHAR(30)\n  TrieuChung : NVARCHAR(MAX)\n  HuyetAp : NVARCHAR(20)\n  ThanNhiet : DECIMAL\n  ChanDoan : NVARCHAR(MAX)\n  TrangThai : NVARCHAR(30)\n}\n\nentity LoaiXetNghiem {\n  *MaLoaiXN : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenXetNghiem : NVARCHAR(100)\n  MoTa : NVARCHAR(255)\n}\n\nentity ChiDinhXetNghiem {\n  *MaChiDinh : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaPhieuKham : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  MaLoaiXN : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  NgayChiDinh : DATETIME2\n  KetQua : NVARCHAR(MAX)\n  TrangThai : NVARCHAR(30)\n}\n\nentity Thuoc {\n  *MaThuoc : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  TenThuoc : NVARCHAR(100)\n  DonViTinh : NVARCHAR(30)\n  GhiChu : NVARCHAR(255)\n}\n\nentity ToaThuoc {\n  *MaToa : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaPhieuKham : NVARCHAR(20) &lt;&lt;FK,UNIQUE&gt;&gt;\n  NgayLap : DATE\n  LoiDan : NVARCHAR(MAX)\n}\n\nentity ChiTietToaThuoc {\n  *MaToa : NVARCHAR(20) &lt;&lt;PK,FK&gt;&gt;\n  *MaThuoc : NVARCHAR(20) &lt;&lt;PK,FK&gt;&gt;\n  --\n  SoLuong : INT\n  LieuDung : NVARCHAR(100)\n  CachDung : NVARCHAR(255)\n}\n\nentity LichHen {\n  *MaLichHen : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaBN : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  NgayGioHen : DATETIME2\n  LoaiKham : NVARCHAR(30)\n  TrangThai : NVARCHAR(30)\n}\n\nentity ThanhToanVienPhi {\n  *MaThanhToan : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaPhieuKham : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  NgayThanhToan : DATETIME2\n  SoTien : DECIMAL\n  TrangThai : NVARCHAR(30)\n}\n\nentity LichSuCapNhat {\n  *MaNhatKy : NVARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  MaPhieuKham : NVARCHAR(20) &lt;&lt;FK&gt;&gt;\n  NgayCapNhat : DATETIME2\n  NguoiCapNhat : NVARCHAR(100)\n  NoiDung : NVARCHAR(MAX)\n}\n\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDangKy\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; PhiQuanLyNam\nBenhNhan \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBenhAn\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; LichHen\n\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; BacSi\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\n\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; ChiDinhXetNghiem\nLoaiXetNghiem \&quot;1\&quot; -- \&quot;0..*\&quot; ChiDinhXetNghiem\n\nPhieuKham \&quot;1\&quot; -- \&quot;0..1\&quot; ToaThuoc\nToaThuoc \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietToaThuoc\nThuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietToaThuoc\n\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanVienPhi\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuCapNhat\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qA3Mt_rArM6ZjN4LwnIS-1">
