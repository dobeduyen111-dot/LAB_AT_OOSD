        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\nleft to right direction\nskinparam classAttributeIconSize 0\n\nclass FrmKhamBenh &lt;&lt;boundary&gt;&gt; {\n  +XuLyTraCuu()\n  +XuLyLapPhieuKham()\n  +XuLyLuuChanDoan()\n}\n\nclass KhamBenhService &lt;&lt;control&gt;&gt; {\n  +TraCuuHoSo(maHoSo): object\n  +LayLichSuKham(maHoSo): object\n  +LapPhieuKham(thongTin): bool\n  +GhiNhanChanDoan(maPhieu, chanDoan): bool\n}\n\nclass XetNghiemService &lt;&lt;control&gt;&gt; {\n  +LapChiDinh(maPhieu, maLoaiXN): bool\n  +GhiKetQua(maChiDinh, ketQua): bool\n}\n\nclass SqlServerDb &lt;&lt;database&gt;&gt; {\n  +ExecuteQuery()\n  +ExecuteNonQuery()\n}\n\nclass BenhNhan &lt;&lt;entity&gt;&gt; {\n  +MaBN: string\n  +HoTen: string\n}\n\nclass HoSoBenhAn &lt;&lt;entity&gt;&gt; {\n  +MaHoSo: string\n  +traCuuLichSu()\n}\n\nclass PhieuKham &lt;&lt;entity&gt;&gt; {\n  +MaPhieuKham: string\n  +NgayGio: DateTime\n  +TrieuChung: string\n  +ChanDoan: string\n  +lapPhieuKham()\n  +ghiChanDoan()\n}\n\nclass BacSi &lt;&lt;entity&gt;&gt; {\n  +MaBS: string\n  +HoTen: string\n  +khamBenh()\n}\n\nclass KhoaDieuTri &lt;&lt;entity&gt;&gt; {\n  +MaKhoa: string\n  +TenKhoa: string\n}\n\nclass ChiDinhXetNghiem &lt;&lt;entity&gt;&gt; {\n  +MaChiDinh: string\n  +KetQua: string\n  +lapChiDinh()\n  +ghiKetQua()\n}\n\nFrmKhamBenh ..&gt; KhamBenhService\nFrmKhamBenh ..&gt; XetNghiemService\nKhamBenhService ..&gt; SqlServerDb\nXetNghiemService ..&gt; SqlServerDb\n\nKhamBenhService ..&gt; BenhNhan\nKhamBenhService ..&gt; HoSoBenhAn\nKhamBenhService ..&gt; PhieuKham\nKhamBenhService ..&gt; BacSi\n\nXetNghiemService ..&gt; ChiDinhXetNghiem\n\nHoSoBenhAn \&quot;1\&quot; *-- \&quot;0..*\&quot; PhieuKham\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\nPhieuKham \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiDinhXetNghiem\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xWsuRyZZRA6u5QILNfdH-147">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
