        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\nautonumber\n\nactor \&quot;NV tiếp nhận\&quot; as NV\nboundary \&quot;FrmBenhNhan\&quot; as F\ncontrol \&quot;BenhNhanService\&quot; as S\ndatabase \&quot;SQL Server\&quot; as DB\n\nNV -&gt; F : Nhập thông tin bệnh nhân và ảnh\nNV -&gt; F : Nhấn Đăng ký\n\nF -&gt; S : DangKyBenhNhan(thongTin)\nactivate S\nS -&gt; S : KiemTraThongTin()\nS -&gt; DB : Kiểm tra bệnh nhân đã tồn tại\nDB --&gt; S : Kết quả\n\nalt Dữ liệu trùng hoặc không hợp lệ\n  S --&gt; F : Thông báo lỗi\n  F --&gt; NV : Yêu cầu chỉnh sửa\nelse Thông tin hợp lệ\n  S -&gt; DB : INSERT BenhNhan\n  DB --&gt; S : MaBN\n  S -&gt; DB : INSERT PhieuDangKy\n  DB --&gt; S : Đã lưu\n  S --&gt; F : Đăng ký thành công\nend\ndeactivate S\n\nNV -&gt; F : Ghi nhận lệ phí năm đầu\nF -&gt; S : GhiNhanPhiVaCapHoSo(maBN, thongTinPhi)\nactivate S\n\nS -&gt; DB : Kiểm tra điều kiện cấp hồ sơ\nDB --&gt; S : Kết quả kiểm tra\n\nalt Chưa đủ điều kiện\n  S --&gt; F : Không thể cấp hồ sơ\nelse Đủ điều kiện\n  S -&gt; DB : BEGIN TRANSACTION\n  S -&gt; DB : INSERT PhiQuanLyNam\n  S -&gt; DB : INSERT HoSoBenhAn\n\n  alt Thành công\n    S -&gt; DB : COMMIT\n    DB --&gt; S : MaHoSo\n    S --&gt; F : Trả mã hồ sơ\n    F --&gt; NV : Hiển thị hồ sơ mới\n  else Lỗi lưu dữ liệu\n    S -&gt; DB : ROLLBACK\n    S --&gt; F : Thông báo lỗi\n  end\nend\ndeactivate S\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fgbHhp_kcXnjVIugLhCc-53">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
