        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nhide circle\n\nclass BenhNhan {\n  +MaBN: string &lt;&lt;ID&gt;&gt;\n  +HoTen: string\n  +DiaChi: string\n  +NgaySinh: Date\n  +DienThoai: string\n  +Anh3x4: string\n  +dangKy()\n  +capNhat()\n}\n\nclass PhieuDangKy {\n  +MaPhieuDK: string &lt;&lt;ID&gt;&gt;\n  +MaBN: string\n  +NgayDangKy: Date\n  +TrangThai: string\n  +lapPhieu()\n  +kiemTra()\n}\n\nclass PhiQuanLyNam {\n  +MaPhi: string &lt;&lt;ID&gt;&gt;\n  +MaBN: string\n  +Nam: int\n  +SoTien: decimal\n  +NgayDong: Date\n  +TrangThai: string\n  +ghiNhanPhi()\n  +kiemTraHieuLuc()\n}\n\nclass HoSoBenhAn {\n  +MaHoSo: string &lt;&lt;ID&gt;&gt;\n  +MaBN: string\n  +NgayCap: Date\n  +TrangThai: string\n  +capHoSo()\n  +traCuuLichSu()\n}\n\nclass KhoaDieuTri {\n  +MaKhoa: string &lt;&lt;ID&gt;&gt;\n  +TenKhoa: string\n  +MoTa: string\n  +themKhoa()\n}\n\nclass BacSi {\n  +MaBS: string &lt;&lt;ID&gt;&gt;\n  +MaKhoa: string\n  +HoTen: string\n  +ChuyenMon: string\n  +DienThoai: string\n  +traCuu()\n  +khamBenh()\n}\n\nclass PhieuKham {\n  +MaPhieuKham: string &lt;&lt;ID&gt;&gt;\n  +MaHoSo: string\n  +MaBS: string\n  +MaKhoa: string\n  +NgayGio: DateTime\n  +LoaiKham: string\n  +TrieuChung: string\n  +HuyetAp: string\n  +ThanNhiet: decimal\n  +ChanDoan: string\n  +TrangThai: string\n  +lapPhieuKham()\n  +ghiChanDoan()\n}\n\nclass LoaiXetNghiem {\n  +MaLoaiXN: string &lt;&lt;ID&gt;&gt;\n  +TenXetNghiem: string\n  +MoTa: string\n  +themLoaiXN()\n}\n\nclass ChiDinhXetNghiem {\n  +MaChiDinh: string &lt;&lt;ID&gt;&gt;\n  +MaPhieuKham: string\n  +MaLoaiXN: string\n  +NgayChiDinh: DateTime\n  +KetQua: string\n  +TrangThai: string\n  +lapChiDinh()\n  +ghiKetQua()\n}\n\nclass Thuoc {\n  +MaThuoc: string &lt;&lt;ID&gt;&gt;\n  +TenThuoc: string\n  +DonViTinh: string\n  +GhiChu: string\n  +traCuuThuoc()\n}\n\nclass ToaThuoc {\n  +MaToa: string &lt;&lt;ID&gt;&gt;\n  +MaPhieuKham: string\n  +NgayLap: Date\n  +LoiDan: string\n  +lapToa()\n  +xemToa()\n}\n\nclass ChiTietToaThuoc {\n  +MaToa: string &lt;&lt;ID&gt;&gt;\n  +MaThuoc: string &lt;&lt;ID&gt;&gt;\n  +SoLuong: int\n  +LieuDung: string\n  +CachDung: string\n  +themChiTiet()\n}\n\nclass LichHen {\n  +MaLichHen: string &lt;&lt;ID&gt;&gt;\n  +MaBN: string\n  +NgayGioHen: DateTime\n  +LoaiKham: string\n  +TrangThai: string\n  +datLich()\n  +huyLich()\n}\n\nclass ThanhToanVienPhi {\n  +MaThanhToan: string &lt;&lt;ID&gt;&gt;\n  +MaPhieuKham: string\n  +NgayThanhToan: DateTime\n  +SoTien: decimal\n  +TrangThai: string\n  +ghiThanhToan()\n}\n\nclass LichSuCapNhat {\n  +MaNhatKy: string &lt;&lt;ID&gt;&gt;\n  +MaPhieuKham: string\n  +NgayCapNhat: DateTime\n  +NguoiCapNhat: string\n  +NoiDung: string\n  +ghiNhanSauXuatVien()\n}\n\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDangKy\nBenhNhan \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBenhAn\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; PhiQuanLyNam\nBenhNhan \&quot;1\&quot; -- \&quot;0..*\&quot; LichHen\n\nHoSoBenhAn \&quot;1\&quot; *-- \&quot;0..*\&quot; PhieuKham\n\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; BacSi\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKham\n\nPhieuKham \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiDinhXetNghiem\nLoaiXetNghiem \&quot;1\&quot; -- \&quot;0..*\&quot; ChiDinhXetNghiem\n\nPhieuKham \&quot;1\&quot; *-- \&quot;0..1\&quot; ToaThuoc\nToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc\nThuoc \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietToaThuoc\n\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanVienPhi\nPhieuKham \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuCapNhat\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BD4TJdFOvHt436YXlp_3-1">
