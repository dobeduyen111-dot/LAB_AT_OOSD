        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n\n    actor ND as Độc giả / Thủ thư\n    participant UI as Giao diện\n    participant BUS as Dịch vụ nghiệp vụ\n    participant DB as CSDL\n\n    ND-&gt;&gt;UI: 1. Tìm kiếm sách cần xem\n    UI-&gt;&gt;BUS: 2. Gửi yêu cầu tìm kiếm sách\n    BUS-&gt;&gt;DB: 3. Truy vấn sách\n    DB--&gt;&gt;BUS: 4. Trả về danh sách sách\n\n    alt Không tìm thấy sách\n        BUS--&gt;&gt;UI: 5. Thông báo không có sách\n        UI--&gt;&gt;ND: 6. Hiển thị thông báo không có sách\n        ND-&gt;&gt;UI: 7. Chọn lại chức năng tìm kiếm\n        UI-&gt;&gt;BUS: 8. Tìm kiếm sách khác\n        BUS-&gt;&gt;DB: 9. Truy vấn lại sách\n        DB--&gt;&gt;BUS: 10. Trả về danh sách sách\n    else Tìm thấy sách\n        BUS--&gt;&gt;UI: 5. Trả về danh sách sách\n        UI--&gt;&gt;ND: 6. Hiển thị danh sách sách phù hợp\n\n        ND-&gt;&gt;UI: 7. Chọn sách cần xem\n        UI-&gt;&gt;BUS: 8. Yêu cầu thông tin chi tiết\n        BUS-&gt;&gt;DB: 9. Truy vấn thông tin chi tiết\n        DB--&gt;&gt;BUS: 10. Trả về thông tin chi tiết\n        BUS--&gt;&gt;UI: 11. Trả về thông tin chi tiết\n        UI--&gt;&gt;ND: 12. Hiển thị thông tin chi tiết\n\n        BUS--&gt;&gt;UI: 13. Hiển thị tình trạng sách\n        UI--&gt;&gt;ND: 14. Người dùng xem tình trạng sách\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="gCnukc2pEwLjORxrR-y8-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
