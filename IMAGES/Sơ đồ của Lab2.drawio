        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n\n    actor TT as Thủ thư\n    participant UI as Giao diện\n    participant BUS as Dịch vụ nghiệp vụ\n    participant DB as CSDL\n\n    TT-&gt;&gt;UI: 1. Chọn chức năng quản lý mượn, trả sách\n    UI-&gt;&gt;BUS: 2. Yêu cầu thông tin mượn, trả sách\n    BUS-&gt;&gt;DB: 3. Truy vấn thông tin mượn, trả sách\n    DB--&gt;&gt;BUS: 4. Trả về dữ liệu\n    BUS--&gt;&gt;UI: 5. Trả về thông tin\n    UI--&gt;&gt;TT: 6. Hiển thị thông tin mượn, trả sách\n\n    TT-&gt;&gt;UI: 7. Chọn thông tin cần xem/cập nhật\n    UI-&gt;&gt;BUS: 8. Yêu cầu thông tin chi tiết\n    BUS-&gt;&gt;DB: 9. Truy vấn thông tin chi tiết\n    DB--&gt;&gt;BUS: 10. Trả về dữ liệu chi tiết\n    BUS--&gt;&gt;UI: 11. Trả về thông tin chi tiết\n    UI--&gt;&gt;TT: 12. Hiển thị thông tin chi tiết\n\n    TT-&gt;&gt;UI: 13. Cập nhật thông tin mượn hoặc trả sách\n    UI-&gt;&gt;BUS: 14. Gửi thông tin cập nhật\n    BUS-&gt;&gt;BUS: 15. Kiểm tra thông tin cập nhật\n\n    alt Thông tin không hợp lệ\n        BUS--&gt;&gt;UI: 16. Thông báo lỗi\n        UI--&gt;&gt;TT: 17. Hiển thị thông báo lỗi\n        TT-&gt;&gt;UI: 18. Nhập lại thông tin\n        UI-&gt;&gt;BUS: 19. Gửi lại thông tin cập nhật\n        BUS-&gt;&gt;BUS: 20. Kiểm tra lại thông tin\n    else Thông tin hợp lệ\n        BUS-&gt;&gt;DB: 16. Lưu thông tin mượn, trả sách\n        DB--&gt;&gt;BUS: 17. Xác nhận lưu thành công\n        BUS--&gt;&gt;UI: 18. Thông báo cập nhật thành công\n        UI--&gt;&gt;TT: 19. Hiển thị thông báo thành công\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BhiELtQRwnjWvereCBvv-36">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
