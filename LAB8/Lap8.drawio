  <diagram id="Km1jVg9fpaGPHyuOuMfe" name="Trang-4">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle CLASS DIAGRAM - QUAN LY CHO THUE VAN PHONG\n\ntop to bottom direction\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nskinparam linetype polyline\nskinparam nodesep 45\nskinparam ranksep 55\nskinparam ArrowColor #555555\n\nskinparam class {\n    BackgroundColor #FFF8CC\n    BorderColor #555555\n    FontColor black\n}\n\nhide circle\n\n&#39;===============================\n&#39; 1. CAC LOP NGHIEP VU\n&#39;===============================\n\nclass VanPhong {\n    +MaVP : Integer\n    +Tang : Integer\n    +SoPhong : String\n    +DienTich : Decimal\n    +Huong : String\n    +DonGiaNiemYet : Decimal\n    --\n    +kiemTraPhongTrong() : Boolean\n    +capNhatThongTin() : void\n}\n\nclass KhachThue {\n    +MaKH : Integer\n    +TenDonVi : String\n    +NguoiDaiDien : String\n    +DiaChi : String\n    +DienThoai : String\n    --\n    +dangKyThongTin() : void\n    +capNhatThongTin() : void\n}\n\nclass HopDongThue {\n    +MaHD : Integer\n    +SoHD : String\n    +NgayBatDau : Date\n    +SoThang : Integer\n    +TrangThai : String\n    --\n    +lapHopDong() : void\n    +kiemTraThoiHan() : Boolean\n    +tinhTienThue() : Decimal\n}\n\nclass ChiTietThue {\n    +MaCTThue : Integer\n    +DonGiaThang : Decimal\n    +NgayKetThucHieuLuc : Date\n    --\n    +themVanPhong() : void\n    +tinhTienThue() : Decimal\n}\n\nclass KhoanThanhToan {\n    +MaKhoan : Integer\n    +LoaiKhoan : String\n    +KySo : Integer\n    +NgayDenHan : Date\n    +SoTienPhaiThu : Decimal\n    +SoTienDaThu : Decimal\n    --\n    +ghiNhanThanhToan() : void\n    +tinhConNo() : Decimal\n}\n\nclass DichVuSuDung {\n    +MaSD : Integer\n    +TenDichVu : String\n    +Thang : Integer\n    +Nam : Integer\n    +SoLuong : Decimal\n    +DonGia : Decimal\n    --\n    +ghiNhanSuDung() : void\n    +tinhThanhTien() : Decimal\n}\n\nclass PhieuGiaHan {\n    +MaGiaHan : Integer\n    +NgayLap : Date\n    +SoThangGiaHan : Integer\n    --\n    +kiemTraThoiHan() : Boolean\n    +kiemTraCongNo() : Boolean\n    +lapGiaHan() : void\n}\n\nclass NhanVienVanPhong {\n    +MaNV : Integer\n    +HoTen : String\n    +ChucVu : String\n    +HinhAnh : String\n    +MaTheXe : String\n    +BienSoXe : String\n    --\n    +capNhatNhanVien() : void\n    +capTheXe() : void\n}\n\nclass KiemTraPhong {\n    +MaKT : Integer\n    +NgayKiemTra : Date\n    +TinhTrang : String\n    +TuYSuaDoi : Boolean\n    +SoTienPhat : Decimal\n    --\n    +ghiNhanKiemTra() : void\n    +lapPhieuPhat() : void\n}\n\n&#39;===============================\n&#39; 2. CAC MOI QUAN HE UML\n&#39;===============================\n\nKhachThue \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongThue : ky hop dong\n\nHopDongThue \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietThue : bao gom\n\nVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietThue : duoc thue\n\nChiTietThue \&quot;1\&quot; -- \&quot;0..*\&quot; KhoanThanhToan : phat sinh\n\nChiTietThue \&quot;1\&quot; -- \&quot;0..*\&quot; DichVuSuDung : su dung\n\nKhoanThanhToan \&quot;0..1\&quot; -- \&quot;0..*\&quot; DichVuSuDung : thanh toan dich vu\n\nChiTietThue \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaHan : gia han\n\nKhachThue \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienVanPhong : quan ly nhan vien\n\nVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienVanPhong : noi lam viec\n\nVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; KiemTraPhong : duoc kiem tra\n\nChiTietThue \&quot;0..1\&quot; -- \&quot;0..*\&quot; KiemTraPhong : ghi nhan vi pham\n\n&#39;===============================\n&#39; 3. RANG BUOC NGHIEP VU\n&#39;===============================\n\nnote right of HopDongThue\n    Thoi gian thue &gt;= 6 thang\n    Mot hop dong co the\n    thue nhieu van phong\nend note\n\nnote right of PhieuGiaHan\n    Gia han &lt;= 1/2\n    thoi gian thue goc\n\n    Khong con no tien thue\n    va tien dich vu\nend note\n\nnote bottom of KhoanThanhToan\n    Tien thue 6 thang dau:\n    thanh toan truoc\n\n    Tu thang 7:\n    thanh toan dau thang\n\n    Dich vu:\n    thanh toan cuoi thang\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8CgonJdUL1g6SMPFTEvG-182">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=15;" vertex="1">
