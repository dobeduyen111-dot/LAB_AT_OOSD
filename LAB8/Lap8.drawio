      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle HINH P.4 - TRANG THAI HOP DONG THUE\n\nskinparam shadowing false\nskinparam ArrowColor #B31D43\n\nskinparam state {\n BackgroundColor #FFF8D7\n BorderColor #B31D43\n}\n\n[*] --&gt; ChoThuTruoc : Lap hop dong &gt;= 6 thang\n\nstate \&quot;Cho thu truoc 6 thang\&quot; as ChoThuTruoc\nstate \&quot;Dang hieu luc\&quot; as HieuLuc\nstate \&quot;Thu tien thang 7+\&quot; as KySau\nstate \&quot;Het han\&quot; as HetHan\nstate \&quot;Da huy\&quot; as Huy\n\nChoThuTruoc --&gt; HieuLuc : Thu du tien 6 thang dau\nChoThuTruoc --&gt; Huy : Huy hop dong hop le\n\nHieuLuc --&gt; KySau : Bat dau ky 7 neu co\nHieuLuc --&gt; HetHan : Ket thuc hop dong 6 thang\n\nKySau --&gt; KySau : Thu tien dau ky\nKySau --&gt; KySau : Thanh toan dich vu cuoi thang\nKySau --&gt; HetHan : Het thoi han thue\n\nHetHan --&gt; HieuLuc : Gia han du dieu kien\n\nHuy --&gt; [*]\nHetHan --&gt; [*]\n\nnote right of KySau\n  Gia han theo tung van phong.\n  Khong cho phep neu con no\n  tien thue hoac dich vu.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7l7GhmzM_AVq4I7EEkhb-470">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
