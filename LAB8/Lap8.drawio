        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle P.7 - KIEN TRUC HE THONG QUAN LY VAN PHONG\n\nleft to right direction\nskinparam shadowing false\nskinparam ArrowColor #AC3150\n\nskinparam component {\n BackgroundColor #FFF6CE\n BorderColor #AC3150\n}\n\npackage \&quot;WINDOWS FORMS\&quot; {\n [FrmMain] as M\n [FrmDanhMuc] as DM\n [FrmHopDong] as HD\n [FrmThuTien] as TT\n [FrmDichVu] as DV\n [FrmGiaHan] as GH\n [FrmNhanVienTheXe] as NV\n [FrmKiemTra] as KT\n}\n\npackage \&quot;BUSINESS SERVICES\&quot; {\n [DanhMucService] as S1\n [HopDongService] as S2\n [ThanhToanService] as S3\n [DichVuService] as S4\n [GiaHanService] as S5\n [NhanVienService] as S6\n [KiemTraService] as S7\n}\n\ncomponent \&quot;Db.cs\\nADO.NET\&quot; as DB\n\ndatabase \&quot;SQL Server\\nQuanLyVanPhongBai4_Gon\&quot; as SQL\n\nM --&gt; DM\nM --&gt; HD\nM --&gt; TT\nM --&gt; DV\nM --&gt; GH\nM --&gt; NV\nM --&gt; KT\n\nDM --&gt; S1\nHD --&gt; S2\nTT --&gt; S3\nDV --&gt; S4\nGH --&gt; S5\nNV --&gt; S6\nKT --&gt; S7\n\nS1 --&gt; DB\nS2 --&gt; DB\nS3 --&gt; DB\nS4 --&gt; DB\nS5 --&gt; DB\nS6 --&gt; DB\nS7 --&gt; DB\n\nDB --&gt; SQL\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LixyK_37M87vhKANrUun-120">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
