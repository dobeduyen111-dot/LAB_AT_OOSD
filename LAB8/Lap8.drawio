        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ERD - QUAN LY VAN PHONG - 10 BANG\n\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\n\nskinparam entity {\n BackgroundColor #FFF6CE\n BorderColor #AC3150\n}\n\nentity VanPhong {\n * MaVP : INT &lt;&lt;PK&gt;&gt;\n --\n Tang : INT\n SoPhong : NVARCHAR\n Huong : NVARCHAR\n DienTich : DECIMAL\n DonGiaNiemYet : DECIMAL\n}\n\nentity KhachThue {\n * MaKH : INT &lt;&lt;PK&gt;&gt;\n --\n TenDonVi : NVARCHAR\n NguoiDaiDien : NVARCHAR\n DiaChi : NVARCHAR\n DienThoai : VARCHAR\n}\n\nentity HopDongThue {\n * MaHD : INT &lt;&lt;PK&gt;&gt;\n --\n MaKH : INT &lt;&lt;FK&gt;&gt;\n SoHD : NVARCHAR &lt;&lt;UNIQUE&gt;&gt;\n NgayKy : DATE\n NgayBatDau : DATE\n SoThang : INT\n TrangThai : VARCHAR\n}\n\nentity ChiTietThue {\n * MaCTThue : INT &lt;&lt;PK&gt;&gt;\n --\n MaHD : INT &lt;&lt;FK&gt;&gt;\n MaVP : INT &lt;&lt;FK&gt;&gt;\n DonGiaThang : DECIMAL\n NgayKetThucHieuLuc : DATE\n}\n\nentity KhoanThanhToan {\n * MaKhoan : INT &lt;&lt;PK&gt;&gt;\n --\n MaCTThue : INT &lt;&lt;FK&gt;&gt;\n LoaiKhoan : VARCHAR\n KySo : INT\n Thang : TINYINT\n Nam : SMALLINT\n NgayDenHan : DATE\n SoTienPhaiThu : DECIMAL\n}\n\nentity LanThanhToan {\n * MaThanhToan : INT &lt;&lt;PK&gt;&gt;\n --\n MaKhoan : INT &lt;&lt;FK&gt;&gt;\n NgayThu : DATE\n SoTien : DECIMAL\n SoChungTu : NVARCHAR\n}\n\nentity DichVuSuDung {\n * MaSD : INT &lt;&lt;PK&gt;&gt;\n --\n MaCTThue : INT &lt;&lt;FK&gt;&gt;\n MaKhoan : INT &lt;&lt;FK&gt;&gt;\n TenDichVu : NVARCHAR\n Thang : TINYINT\n Nam : SMALLINT\n SoLuong : DECIMAL\n DonGia : DECIMAL\n}\n\nentity PhieuGiaHan {\n * MaGiaHan : INT &lt;&lt;PK&gt;&gt;\n --\n MaCTThue : INT &lt;&lt;FK&gt;&gt;\n NgayLap : DATE\n SoThangGiaHan : INT\n NgayKetThucCu : DATE\n NgayKetThucMoi : DATE\n}\n\nentity NhanVienVanPhong {\n * MaNV : INT &lt;&lt;PK&gt;&gt;\n --\n MaKH : INT &lt;&lt;FK&gt;&gt;\n MaVP : INT &lt;&lt;FK&gt;&gt;\n HoTen : NVARCHAR\n ChucVu : NVARCHAR\n 