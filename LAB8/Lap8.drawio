        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle HINH P.6 - ACTIVITY DIAGRAM HOP DONG VA THANH TOAN\n\nskinparam shadowing false\nskinparam ArrowColor #B31D43\n\nskinparam activity {\n BackgroundColor #FFF8D7\n BorderColor #B31D43\n DiamondBackgroundColor #FFF8D7\n DiamondBorderColor #B31D43\n}\n\nstart\n\n|Nhan vien quan ly|\n:Chon khach thue va cac van phong;\n:Nhap thoi han thue va gia tung phong;\n\n|He thong|\n:Kiem tra phong trong;\n:Kiem tra thoi han &gt;= 6 thang;\n\nif (Thong tin hop le?) then (Co)\n  :Luu hop dong va cac ky tien thue;\nelse (Khong)\n  :Thong bao du lieu khong hop le;\n  stop\nendif\n\n|Ke toan|\n:Thu truoc tien thue 6 thang dau;\n\n|He thong|\n:Kich hoat hop dong;\n\nwhile (Con ky thue?) is (Co)\n\n  if (Ky thue tu thang 7?) then (Co)\n    |Ke toan|\n    :Thu tien thue vao dau thang;\n  endif\n\n  |Nhan vien dich vu|\n  :Ghi nhan dien, nuoc, Internet;\n\n  |Ke toan|\n  :Lap hoa don dich vu cuoi thang;\n  :Ghi nhan thanh toan dich vu;\n\n  |He thong|\n  :Cap nhat cong no;\n\nendwhile (Khong)\n\n:Dong ky thue hoac xem xet gia han;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PJWPop2GhJWIPqlB7729-55">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
