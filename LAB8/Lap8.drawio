        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle P.2 - USE CASE PHAN RA HOP DONG VA THANH TOAN\n\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam ArrowColor #B31D43\n\nskinparam usecase {\n BackgroundColor #FFF8D7\n BorderColor #B31D43\n}\n\nactor \&quot;NV quản lý\&quot; as QL\nactor \&quot;Kế toán\&quot; as KT\nactor \&quot;NV dịch vụ\&quot; as DV\n\nrectangle \&quot;QUY TRÌNH KÝ HỢP ĐỒNG - THANH TOÁN\&quot; {\n usecase \&quot;Lập hợp đồng thuê\&quot; as HD\n usecase \&quot;Chọn nhiều văn phòng\&quot; as CHON\n usecase \&quot;Kiểm tra phòng trống\&quot; as TRONG\n usecase \&quot;Kiểm tra thời hạn &gt;= 6 tháng\&quot; as KY\n usecase \&quot;Chốt đơn giá từng phòng\&quot; as GIA\n usecase \&quot;Thu trước 6 tháng đầu\&quot; as T6\n usecase \&quot;Phát sinh nghĩa vụ\\ntháng thứ 7 trở đi\&quot; as KY7\n usecase \&quot;Thu tiền thuê đầu tháng\&quot; as T7\n usecase \&quot;Ghi dịch vụ sử dụng\&quot; as SD\n usecase \&quot;Lập hóa đơn dịch vụ cuối tháng\&quot; as HDS\n usecase \&quot;Thanh toán hóa đơn dịch vụ\&quot; as TTDV\n}\n\nQL -- HD\nKT -- T6\nKT -- KY7\nKT -- T7\nDV -- SD\nKT -- HDS\nKT -- TTDV\n\nHD ..&gt; CHON : &lt;&lt;include&gt;&gt;\nHD ..&gt; TRONG : &lt;&lt;include&gt;&gt;\nHD ..&gt; KY : &lt;&lt;include&gt;&gt;\nHD ..&gt; GIA : &lt;&lt;include&gt;&gt;\nHD ..&gt; T6 : &lt;&lt;include&gt;&gt;\n\nT7 ..&gt; KY7 : &lt;&lt;include&gt;&gt;\nHDS ..&gt; SD : &lt;&lt;include&gt;&gt;\nTTDV ..&gt; HDS : &lt;&lt;include&gt;&gt;\n\nnote bottom of T7\n Chỉ phát sinh từ tháng thứ 7.\n Tiền thuê trả đầu tháng.\nend note\n\nnote bottom of HDS\n Điện, nước, Internet...\n được tính ngoài giá thuê.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ktsYRVcGbEDNISfwk6zK-46">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
