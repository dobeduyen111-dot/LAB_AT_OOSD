  <diagram id="3JXWU_UcsCXfvgiHXJY_" name="Trang-3">
    <mxGraphModel dx="1420" dy="1184" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle HINH P.5 - SEQUENCE DIAGRAM LAP PHIEU GIA HAN\n\nskinparam shadowing false\n\nactor \&quot;Nhan vien quan ly\&quot; as QL\nboundary \&quot;FrmGiaHan\&quot; as UI\ncontrol \&quot;GiaHanService\&quot; as SV\ndatabase \&quot;SQL Server\&quot; as DB\n\nQL -&gt; UI : Chon hop dong, phong, so thang gia han\n\nUI -&gt; SV : LapPhieuGiaHan(maCTThue, ngayLap, soThang)\n\nactivate SV\n\nSV -&gt; DB : BEGIN TRANSACTION / khoa ban ghi thue\nDB --&gt; SV : Thong tin phong, han goc, ngay het han\n\nSV -&gt; SV : Kiem tra so thang &lt;= 1/2 ky goc\n\nalt Vuot gioi han gia han\n\n  SV -&gt; DB : ROLLBACK\n  SV --&gt; UI : Tu choi gia han\n\nelse Trong gioi han\n\n  SV -&gt; DB : Truy van ky thue va tien da thu\n  DB --&gt; SV : Cong no tien thue\n\n  SV -&gt; DB : Truy van hoa don va thanh toan dich vu\n  DB --&gt; SV : Cong no dich vu\n\n  alt Con no tien thue hoac dich vu\n\n    SV -&gt; DB : ROLLBACK\n    SV --&gt; UI : Tu choi, hien thi khoan no\n\n  else Khong con no\n\n    SV -&gt; DB : Kiem tra trung lich thue van phong\n\n    alt Trung lich\n\n      SV -&gt; DB : ROLLBACK\n      SV --&gt; UI : Phong da co lich thue\n\n    else Hop le\n\n      SV -&gt; DB : INSERT PhieuGiaHan\n      SV -&gt; DB : INSERT KyTienThue cho thang gia han\n      SV -&gt; DB : UPDATE ChiTietThue.NgayKetThucHieuLuc\n      SV -&gt; DB : COMMIT\n\n      DB --&gt; SV : Ma phieu gia han, ngay ket thuc moi\n      SV --&gt; UI : Gia han thanh cong\n\n    end\n  end\nend\n\ndeactivate SV\n\nUI --&gt; QL : Hien thi ket qua\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PJWPop2GhJWIPqlB7729-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontFamily=Times New Roman;fontSize=15;" vertex="1">
